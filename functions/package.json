{
  "name": "ripot-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-ripot-founders --config ../firebase.test.json \"npm test\"",
    "founders:audit": "node scripts/founders.js",
    "activity:audit": "node scripts/activity.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^10.0.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    },
    "@google-cloud/firestore-api": {
      "google-gax": "5.0.4"
    }
  }
}
